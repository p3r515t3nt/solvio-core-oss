# SOLVIO Core — public example configuration. Placeholders only; never real values.
# Copy to .env (chmod 600). .env is ignored by Git.

# Reasoning provider (platform API key, not a chat subscription).
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# Local service.
SOLVIO_HOST=127.0.0.1
SOLVIO_PORT=8765
SOLVIO_LOG_LEVEL=INFO

# Installation identity (portable defaults in the public distribution).
# Empty = the checkout this code runs from.
SOLVIO_CORE_REPO=
# Companion-app repository (optional; only used by the local backup inventory;
# empty = ~/solvio-ios).
SOLVIO_IOS_REPO=
# Home directory of the account that runs the Core (used by helper processes that run
# under a different account). Empty = the current user's home.
SOLVIO_CORE_HOME=
# Name the assistant uses when it speaks or calls on your behalf.
SOLVIO_OWNER_NAME=

# Companion app (device attestation). The approval path refuses to start without the
# 10-character Apple Team ID of YOUR build of the companion app.
SOLVIO_APP_ATTEST_TEAM=
SOLVIO_APP_ATTEST_BUNDLE=de.solvio.approvals

# Home Assistant (optional). Use your own instance; no default address is shipped.
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=

# Voice satellite (optional).
VOICE_SATELLITE_HOST=

# Telephony (optional; identifiers only — the provider key lives in the secret vault).
TELEPHONY_ENABLED=false
TELEPHONY_AGENT_ID=
TELEPHONY_PHONE_NUMBER_ID=
